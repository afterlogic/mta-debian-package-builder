#!/bin/bash
DEFAULT_DATA_DIR="/opt/afterlogic/html/data"
SETTINGS_FILE="/opt/afterlogic/html/inc_settings_path.php"

# Data directory can be relocated via inc_settings_path.php (see
# https://afterlogic.com/docs/aurora/security/protecting-data-directory) --
# resolve it the same way Aurora\System\Api::DataPath() does, so upgrades
# don't clobber a relocated data directory.
resolve_data_dir() {
    local resolved=""
    if [ -f "$SETTINGS_FILE" ] && command -v php >/dev/null 2>&1; then
        resolved=$(php -d display_errors=0 -r '
            $dataPath = "data";
            @include $argv[1];
            // inc_settings_path.php can set either $dataPath or define(AU_API_DATA_FOLDER, ...)
            // directly (the documented mechanism) - Api::DataPath() checks the constant first,
            // so this has to match or a define()-only settings file is silently ignored here.
            if (defined("AU_API_DATA_FOLDER")) { $dataPath = AU_API_DATA_FOLDER; }
            $dataPath = (string) $dataPath;
            if ($dataPath === "") { $dataPath = "data"; }
            if ($dataPath[0] !== "/") { $dataPath = "/opt/afterlogic/html/" . $dataPath; }
            echo rtrim($dataPath, "/");
        ' "$SETTINGS_FILE" 2>/dev/null)
    fi
    if [ -z "$resolved" ] || [ "$resolved" = "/" ]; then
        resolved="$DEFAULT_DATA_DIR"
    fi
    echo "$resolved"
}

DATA_DIR=$(resolve_data_dir)

if [ "$1" = "upgrade" ] && [ "$2" != "" ]; then
    if [ -d /tmp/amsdata ]; then
        rm -rf /tmp/amsdata
    fi
    mkdir /tmp/amsdata
    if [ -d "$DATA_DIR" ]; then
        mv "$DATA_DIR"/* /tmp/amsdata/ 2>/dev/null
    fi
fi
